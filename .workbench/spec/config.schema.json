{
  "schema": 1,
  "config_version": 5,
  "closed": true,
  "keys": {
    "config_version": {
      "type": "integer",
      "required": true,
      "const": 5
    },
    "doc_version": {
      "type": "string",
      "required": true
    },
    "events_schema_version": {
      "type": "integer",
      "required": true,
      "const": 4
    },
    "project_uuid": {
      "type": "string",
      "required": true,
      "pattern": "^[0-9a-f]{32}$"
    },
    "platform": {
      "type": "object",
      "required": true,
      "children": {
        "os": {
          "type": "string",
          "enum": [
            "auto",
            "win32",
            "posix"
          ]
        },
        "case_sensitive_paths": {
          "type": "string",
          "enum": [
            "auto",
            "true",
            "false"
          ]
        },
        "min_git_version": {
          "type": "string"
        }
      }
    },
    "global_config": {
      "type": "object",
      "required": true,
      "children": {
        "batch_max_parallel": {
          "type": "integer",
          "min": 1,
          "max": 3
        },
        "lease_ttl_sec": {
          "type": "integer",
          "min": 5,
          "max": 600
        },
        "lease_heartbeat_sec": {
          "type": "integer",
          "min": 1,
          "max": 120
        },
        "task_hard_timeout_min": {
          "type": "integer",
          "min": 1
        },
        "verify_timeout_sec": {
          "type": "integer",
          "min": 30
        },
        "task_archive_day": {
          "type": "integer",
          "min": 1
        },
        "wt_ttl_hours": {
          "type": "integer",
          "min": 1
        },
        "human_gate_sla_min": {
          "type": "integer",
          "min": 1
        },
        "max_attempts": {
          "type": "integer",
          "min": 1,
          "max": 10
        },
        "auto_approve_draft": {
          "type": "boolean"
        },
        "kill_grace_sec": {
          "type": "integer",
          "min": 1,
          "max": 60
        },
        "single_task_budget": {
          "type": "object"
        },
        "daily_budget": {
          "type": "object"
        }
      }
    },
    "mg": {
      "type": "object",
      "required": true,
      "children": {
        "max_file_count": {
          "type": "integer",
          "min": 1
        },
        "max_net_line_count": {
          "type": "integer",
          "min": 1
        },
        "gray_batch_max": {
          "type": "integer",
          "min": 1
        },
        "allowed_paths": {
          "type": "array"
        },
        "generated_paths": {
          "type": "array"
        },
        "smoke_cmd": {
          "type": "string"
        },
        "never_waive": {
          "type": "array"
        }
      }
    },
    "notify": {
      "type": "object",
      "required": true,
      "children": {
        "channels": {
          "type": "array"
        },
        "watch_dog": {
          "type": "object"
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": true,
      "children": {
        "collector_sec": {
          "type": "integer",
          "min": 30
        },
        "window_days": {
          "type": "integer",
          "min": 1
        },
        "snapshot_interval_min": {
          "type": "integer",
          "min": 1
        },
        "snapshot_retention_day": {
          "type": "integer",
          "min": 1
        }
      }
    },
    "security": {
      "type": "object",
      "required": true,
      "children": {
        "manifest_verify": {
          "type": "object"
        },
        "secret_scan": {
          "type": "object"
        },
        "path_policy": {
          "type": "object"
        }
      }
    },
    "digests": {
      "type": "object"
    },
    "persona": {
      "type": "object",
      "children": {
        "inject_max_chars": {
          "type": "integer",
          "min": 200,
          "max": 20000
        }
      }
    },
    "memory": {
      "type": "object",
      "children": {
        "recall_top_n": {
          "type": "integer",
          "min": 1,
          "max": 50
        },
        "working_max_entries": {
          "type": "integer",
          "min": 1,
          "max": 1000
        },
        "fuzzy_after_days": {
          "type": "integer",
          "min": 0
        },
        "forget_after_days": {
          "type": "integer",
          "min": 0
        },
        "repeat_min_count": {
          "type": "integer",
          "min": 1,
          "max": 20
        },
        "longterm_min_count": {
          "type": "integer",
          "min": 1,
          "max": 20
        },
        "importance": {
          "type": "object"
        },
        "vector": {
          "type": "object",
          "children": {
            "enabled": {
              "type": "boolean"
            },
            "dims": {
              "type": "integer",
              "min": 64,
              "max": 4096
            },
            "keyword_weight_bp": {
              "type": "integer",
              "min": 0,
              "max": 10000
            },
            "min_cos_bp": {
              "type": "integer",
              "min": 0,
              "max": 10000
            }
          }
        }
      }
    },
    "emotion": {
      "type": "object",
      "children": {
        "base": {
          "type": "integer",
          "min": 0,
          "max": 100
        },
        "floor": {
          "type": "integer",
          "min": 0,
          "max": 100
        },
        "decay_half_hours": {
          "type": "integer",
          "min": 1,
          "max": 720
        },
        "affect_reset_minutes": {
          "type": "integer",
          "min": 0
        }
      }
    },
    "dream": {
      "type": "object",
      "children": {
        "min_events": {
          "type": "integer",
          "min": 0
        },
        "window_hours": {
          "type": "integer",
          "min": 1,
          "max": 168
        },
        "backlog_days": {
          "type": "integer",
          "min": 0,
          "max": 60
        },
        "max_growth_candidates": {
          "type": "integer",
          "min": 0,
          "max": 20
        }
      }
    },
    "agents": {
      "type": "object",
      "required": true,
      "children": {
        "registry": {
          "type": "string"
        },
        "default_pool": {
          "type": "string"
        }
      }
    },
    "scheduler": {
      "type": "object",
      "required": true,
      "children": {
        "tick_sec": {
          "type": "integer",
          "min": 5,
          "max": 3600
        },
        "stale_factor": {
          "type": "integer",
          "min": 2,
          "max": 20
        },
        "jobs": {
          "type": "object",
          "required": true,
          "children": {
            "health": {
              "type": "object",
              "required": true,
              "children": {
                "enabled": {
                  "type": "boolean"
                },
                "interval_sec": {
                  "type": "integer",
                  "min": 10
                },
                "timeout_sec": {
                  "type": "integer",
                  "min": 1,
                  "max": 86400
                }
              }
            },
            "gate_timer": {
              "type": "object",
              "required": true,
              "children": {
                "enabled": {
                  "type": "boolean"
                },
                "interval_sec": {
                  "type": "integer",
                  "min": 10
                },
                "timeout_sec": {
                  "type": "integer",
                  "min": 1,
                  "max": 86400
                }
              }
            },
            "metrics": {
              "type": "object",
              "required": true,
              "children": {
                "enabled": {
                  "type": "boolean"
                },
                "interval_sec": {
                  "type": "integer",
                  "min": 10
                },
                "timeout_sec": {
                  "type": "integer",
                  "min": 1,
                  "max": 86400
                }
              }
            },
            "gc": {
              "type": "object",
              "required": true,
              "children": {
                "enabled": {
                  "type": "boolean"
                },
                "interval_sec": {
                  "type": "integer",
                  "min": 60
                },
                "timeout_sec": {
                  "type": "integer",
                  "min": 1,
                  "max": 86400
                }
              }
            },
            "observe": {
              "type": "object",
              "children": {
                "enabled": {
                  "type": "boolean"
                },
                "interval_sec": {
                  "type": "integer",
                  "min": 10
                },
                "timeout_sec": {
                  "type": "integer",
                  "min": 1,
                  "max": 86400
                }
              }
            },
            "decay": {
              "type": "object",
              "children": {
                "enabled": {
                  "type": "boolean"
                },
                "interval_sec": {
                  "type": "integer",
                  "min": 60
                },
                "timeout_sec": {
                  "type": "integer",
                  "min": 1,
                  "max": 86400
                }
              }
            },
            "settle": {
              "type": "object",
              "children": {
                "enabled": {
                  "type": "boolean"
                },
                "interval_sec": {
                  "type": "integer",
                  "min": 60
                },
                "timeout_sec": {
                  "type": "integer",
                  "min": 1,
                  "max": 86400
                }
              }
            },
            "dream": {
              "type": "object",
              "children": {
                "enabled": {
                  "type": "boolean"
                },
                "interval_sec": {
                  "type": "integer",
                  "min": 300
                },
                "timeout_sec": {
                  "type": "integer",
                  "min": 1,
                  "max": 86400
                },
                "run_time": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](,([01][0-9]|2[0-3]):[0-5][0-9])*$"
                }
              }
            }
          }
        }
      }
    }
  },
  "cross_checks": [
    {
      "id": "X1",
      "expr": "lease_heartbeat_sec * 3 <= lease_ttl_sec",
      "bindings": {
        "lease_heartbeat_sec": "cfg:global_config.lease_heartbeat_sec",
        "lease_ttl_sec": "cfg:global_config.lease_ttl_sec"
      },
      "msg": "心跳周期必须至少比租约小 3 倍，否则锁会在续期前过期"
    },
    {
      "id": "X2",
      "expr": "task_hard_timeout_min * 60 >= verify_timeout_sec + single_task_wall_clock_min * 60",
      "bindings": {
        "task_hard_timeout_min": "cfg:global_config.task_hard_timeout_min",
        "verify_timeout_sec": "cfg:global_config.verify_timeout_sec",
        "single_task_wall_clock_min": "cfg:global_config.single_task_budget.wall_clock_min"
      },
      "msg": "硬超时必须覆盖 执行 + 验收"
    },
    {
      "id": "X3",
      "expr": "batch_max_parallel <= 3 or os_sandbox_enforced",
      "bindings": {
        "batch_max_parallel": "cfg:global_config.batch_max_parallel",
        "os_sandbox_enforced": "cap:os_sandbox"
      },
      "msg": "无内核级沙箱时并行上限锁 3"
    },
    {
      "id": "X4",
      "expr": "mg_gray_batch_max <= 10",
      "bindings": {
        "mg_gray_batch_max": "cfg:mg.gray_batch_max"
      },
      "msg": "灰区批量人工单签一次不超过 10"
    },
    {
      "id": "X5",
      "expr": "scheduler_stale_sec > scheduler_tick_sec * 2",
      "bindings": {
        "scheduler_stale_sec": "cfg:mul:scheduler.stale_factor,scheduler.tick_sec",
        "scheduler_tick_sec": "cfg:scheduler.tick_sec"
      },
      "msg": "调度器判死的窗口必须比一次 tick 宽两倍以上，否则一次正常的慢 tick 会被自己判成死"
    }
  ]
}
