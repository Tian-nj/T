{
  "schema": 1,
  "criterion": "tool_registry_v1",
  "note": "档位由 tool_registry.classify() 现算，本表只存策略与快照。overrides 只能升档：想放宽请改 rule_table（全体一起变），不要给单个工具开口子 —— 开口子会被下一个工具复制。",
  "tiers": {
    "read_only": {
      "gate": "auto",
      "derivable": true,
      "why": "不写盘、不起子进程、不联外网；调用只记 token_ledger"
    },
    "write_local": {
      "gate": "path_policy",
      "derivable": true,
      "why": "写盘或起子进程，受 spec/paths.yaml 的 allow_write 约束"
    },
    "outbound": {
      "gate": "human_gate",
      "derivable": true,
      "why": "建立外部连接（数据可能离开本机），人工确认后才放行"
    },
    "destructive": {
      "gate": "human_gate",
      "derivable": true,
      "why": "删除文件系统内容，不可回滚，人工确认后才放行"
    },
    "credentials": {
      "gate": "human_gate_never_waive",
      "derivable": false,
      "why": "读写密钥/凭据，命中 never_waive，只能人工加严"
    },
    "release": {
      "gate": "human_gate_never_waive",
      "derivable": false,
      "why": "发布/推送/改版本，命中 never_waive，只能人工加严"
    }
  },
  "rule_table": [
    {
      "when": "deletes",
      "tier": "destructive"
    },
    {
      "when": "connects",
      "tier": "outbound"
    },
    {
      "when": "writes",
      "tier": "write_local"
    },
    {
      "when": "spawns",
      "tier": "write_local"
    },
    {
      "when": "listens",
      "tier": "write_local"
    }
  ],
